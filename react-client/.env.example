# Mapbox GL JS Public Access Token (Required — https://account.mapbox.com/)
VITE_MAPBOX_ACCESS_TOKEN=pk.your_mapbox_public_token_here

# API Base URLs:
# Leave unset/empty in local development or live tunnel mode (share-live.sh) so the React app
# uses relative paths (/api, /tiles, /predict, /chat) proxied automatically by Vite on port 5173.
# Set these only when deploying the frontend to Vercel against remote Render/Railway backend URLs.
VITE_API_BASE_URL=
VITE_NODE_API_URL=
VITE_RISK_API_URL=

# Supabase Auth & Saved Portfolio Configuration (Optional — falls back to local storage/Node API if unset)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
